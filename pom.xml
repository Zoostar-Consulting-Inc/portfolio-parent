<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.zoostarinc.portfolio</groupId>
	<artifactId>portfolio-parent</artifactId>
	<version>1.5.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<parent>
		<groupId>net.zoostar.boot</groupId>
		<artifactId>zoostar-boot-starter-parent</artifactId>
		<version>3.6.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<properties>
		<build.number>${user.name}</build.number>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<sonar.token>${SONAR_TOKEN}</sonar.token>
		<sonar.projectKey>Zoostar-Consulting-Inc_portfolio-parent</sonar.projectKey>
		<sonar.organization>zoostar-consulting-inc</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>
	<modules>
		<module>portfolio-web</module>
		<module>portfolio-api</module>
		<module>portfolio-core</module>
		<module>portfolio-service</module>
	</modules>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>net.zoostar.common</groupId>
				<artifactId>zoostar-common</artifactId>
				<version>3.6.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<configuration>
					<!-- No need to deploy war artifact -->
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<!-- No need to deploy war artifact to maven repo -->
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.tomcat.maven</groupId>
				<artifactId>tomcat7-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>tomcat-maven-deploy</id>
						<phase>${tomcat.maven.deploy.phase}</phase>
						<goals>
							<goal>redeploy</goal>
						</goals>
						<configuration>
							<url>${tomcat.deploy.url}</url>
							<server>tomcat</server>
							<path>/${project.build.finalName}</path>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<url>https://portfolio.apigator.net</url>
	<description>Building RESTful APIs for calculating average cost for stock portfolio.</description>
	<organization>
		<name>Zoostar Cosulting, Inc.</name>
	</organization>
	<scm>
		<url>https://github.com/Zoostar-Consulting-Inc/portfolio-parent</url>
		<developerConnection>zoostar</developerConnection>
	</scm>
	<ciManagement>
		<system>Jenkins</system>
	</ciManagement>
	<profiles>
		<!-- Development Profile -->
		<profile>
			<id>dev</id>
			<activation>
				<activeByDefault>true</activeByDefault> <!-- Active if no other
				profile is specified -->
			</activation>
			<properties>
				<tomcat.deploy.url>http://dev.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>

		<!-- Staging Profile -->
		<profile>
			<id>stage</id>
			<properties>
				<tomcat.deploy.url>http://stage.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>

		<!-- Production Profile -->
		<profile>
			<id>prod</id>
			<properties>
				<tomcat.deploy.url>http://prod.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>
	</profiles>
</project>