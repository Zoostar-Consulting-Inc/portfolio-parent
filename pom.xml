<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.zoostarinc.portfolio</groupId>
	<artifactId>portfolio-parent</artifactId>
	<version>1.4.0</version>
	<packaging>pom</packaging>
	<parent>
		<groupId>net.zoostar.boot</groupId>
		<artifactId>zoostar-boot-starter-parent</artifactId>
		<version>3.6.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<properties>
		<build.number>${user.name}</build.number>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<sonar.token>${SONAR_TOKEN}</sonar.token>
		<sonar.projectKey>Zoostar-Consulting-Inc_portfolio-parent</sonar.projectKey>
		<sonar.organization>zoostar-consulting-inc</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>
	<modules>
		<module>portfolio-web</module>
		<module>portfolio-api</module>
		<module>portfolio-core</module>
	</modules>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>net.zoostar.common</groupId>
				<artifactId>zoostar-common</artifactId>
				<version>3.6.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**</include>
				</includes>
			</resource>
		</resources>
	</build>
	<name>Stock Portfolio for Average Costing RESTful APIs</name>
	<url>https://portfolio.apigator.net</url>
	<description>Building RESTful APIs for calculating average cost for stock portfolio.</description>
	<organization>
		<name>Zoostar Cosulting, Inc.</name>
	</organization>
	<scm>
		<url>https://github.com/Zoostar-Consulting-Inc/portfolio-parent</url>
		<developerConnection>zoostar</developerConnection>
	</scm>
	<ciManagement>
		<system>Jenkins</system>
	</ciManagement>

	<repositories>
		<repository>
			<id>snapshots</id>
			<url>http://archiva.zoostar.net/repository/snapshots/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<releases>
				<enabled>false</enabled>
			</releases>
		</repository>

		<repository>
			<id>internal</id>
			<url>http://archiva.zoostar.net/repository/internal/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<releases>
				<enabled>true</enabled>
			</releases>
		</repository>
	</repositories>

	<profiles>
		<!-- Development Profile -->
		<profile>
			<id>dev</id>
			<activation>
				<activeByDefault>true</activeByDefault> <!-- Active if no other
				profile is specified -->
			</activation>
			<properties>
				<tomcat.deploy.url>http://dev.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>

		<!-- Staging Profile -->
		<profile>
			<id>stage</id>
			<properties>
				<tomcat.deploy.url>http://stage.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>

		<!-- Production Profile -->
		<profile>
			<id>prod</id>
			<properties>
				<tomcat.deploy.url>http://prod.zoostar.net:9080/manager/text</tomcat.deploy.url>
			</properties>
		</profile>
	</profiles>
</project>